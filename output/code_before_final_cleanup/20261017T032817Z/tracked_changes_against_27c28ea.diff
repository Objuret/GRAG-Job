+def prepared(tmp_path=None, **fields):
+    base = dict(chunk_rows=(), chunk_ids=(), graph_tags=(), tag_vectors=np.eye(2),
+                chunk_vectors=np.eye(2), layer={}, tree={'text': TREE, 'paths': {}},
