+def in_turn(orders):
+    """One chunk from each order in turn, a chunk taken once. Returns the chunks and, per chunk,
+    the index of the order whose turn brought it."""
+    out, source, seen = [], [], set()
+    for row in zip(*orders):
+        for which, i in enumerate(row):
+            i = int(i)
+            if i not in seen:
+                seen.add(i)
+                out.append(i)
+                source.append(which)
+    return out, source
+
