+    for e in np.lexsort((-layer['raw'][:, 0], layer['edge_chunk'])).tolist():
+        c = int(layer['edge_chunk'][e])
+        if c in tags:
+            tags[c].append(_readable(prepared.graph_tags[int(layer['edge_tag'][e])]))
+    parts = {}
