-def _csr(pairs, rows):
-    ptr, members = np.zeros(rows + 1, dtype=np.int64), []
-    for i in range(rows):
-        mine = sorted(v for k, v in pairs if k == i)
-        members += mine
-        ptr[i + 1] = ptr[i] + len(mine)
-    return ptr, np.array(members, dtype=np.int64)
