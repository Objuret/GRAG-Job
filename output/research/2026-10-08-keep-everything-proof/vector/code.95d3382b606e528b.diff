+        V._interpret(QUESTION, held)
+    first_key, _ = cached(tmp_path, 'querytag', *Q.request(QUESTION),
+                          {'ok': True, 'raw': answer(), 'usage': {}})
+    with pytest.raises(RuntimeError, match='no cached scope answer'):
+        V._interpret(QUESTION, held)
