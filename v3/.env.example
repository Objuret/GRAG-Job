# Copy to v3/.env — nim._load_dotenv() reads it (never overwrites vars already set).

# --- Required ---

# Your NVIDIA NIM key (build.nvidia.com), prefixed nvapi-.
NVIDIA_API_KEY=nvapi-replace-with-your-key

# Neo4j password for the local server (graph build + artefact arm).
NEO4J_PASSWORD=replace-with-your-password

# --- Optional (defaults shown; uncomment to override) ---

# Neo4j connection.
#NEO4J_URI=neo4j://localhost:7687
#NEO4J_USER=neo4j

# Database the artefact_v1 pipeline queries.
#NEO4J_DATABASE=herb-eval

# Neo4j install dir; only used to report on-disk database size.
#NEO4J_HOME=

# Backup database name used by reembed_herb_eval.py.
#HERB_BACKUP_DATABASE=herb-eval-backup

# Dataset / tag-run identity for the artefact_v1 pipeline.
#HERB_DATASET_ID=Salesforce__HERB
#HERB_TAG_RUN_ID=pilot_full_herb

# NIM throttle: minimum seconds between calls per model (floor 1.5).
#NIM_SECONDS_BETWEEN_CALLS=3.0

# RAGAS judge/embed knobs (floors: timeout 120, tries 3).
#RAGAS_JUDGE_TIMEOUT_S=120
#RAGAS_JUDGE_MAX_TRIES=3
#RAGAS_EMBED_TIMEOUT_S=45
#RAGAS_EMBED_MAX_TRIES=1
#RAGAS_MAX_JUDGE_CONTEXT_CHARS=60000
