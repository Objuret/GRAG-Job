# =============================================================================
# Frontend env — copy to `.env.local` (gitignored) and fill in keys.
# =============================================================================
# Vite reads only vars prefixed with VITE_. Anything else is ignored at build
# time. Restart `npm run dev` after editing this file.

# -----------------------------------------------------------------------------
# Neo4j — the local graph the workbench reads
# -----------------------------------------------------------------------------
VITE_NEO4J_URI=neo4j://localhost:7687
VITE_NEO4J_USER=neo4j
VITE_NEO4J_PASSWORD=
# `herb-eval` is the RAG-safe pruned DB (no QA/oracle sections).
# Use `herb` for full-corpus exploration; never for RAGAS numbers.
VITE_NEO4J_DATABASE=herb-eval

# -----------------------------------------------------------------------------
# LLM providers — only the two below are needed for the cheap thesis path.
# Every provider listed here is OpenAI-API-compatible, so they all share the
# same client code in src/services/llm.ts — only the base URL + key differ.
# -----------------------------------------------------------------------------

# DeepSeek — the workhorse. ~$2.60 for a 100-question × 4-config thesis matrix.
# Get a key: https://platform.deepseek.com/api_keys
# Models: `deepseek-chat` (V3, fast), `deepseek-reasoner` (R1, reasoning)
VITE_DEEPSEEK_API_KEY=

# Ollama Cloud — the FREE comparison model (rate-limited). Use for dev iteration
# and as an open-vs-open thesis comparison point.
# Get a free key: https://ollama.com/settings/keys
# Models: `gpt-oss:120b`, `qwen3-coder:480b`, `deepseek-v3.1:671b`, …
VITE_OLLAMA_API_KEY=

# -----------------------------------------------------------------------------
# Optional fallbacks — leave blank unless you actually want them.
# -----------------------------------------------------------------------------

# Groq — same open-weights models as Ollama Cloud, but paid + ~10× faster.
# Use ONLY if Ollama Cloud's free rate limits become a blocker.
# Get a key: https://console.groq.com/keys
# Models: `llama-3.3-70b-versatile`, `gpt-oss-120b`, `deepseek-r1-distill-llama-70b`
VITE_GROQ_API_KEY=

# Anthropic — only if you want a closed-model Claude anchor in the thesis table.
# Expensive: Sonnet 4.6 ≈ $31 per 800-call matrix, Opus 4.7 ≈ $156.
# Get a key: https://console.anthropic.com/settings/keys
# Models: `claude-haiku-4-5`, `claude-sonnet-4-6`, `claude-opus-4-7`
VITE_ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Default model — the one pre-selected in every new Run card.
# Pick any id whose provider key is set above.
# -----------------------------------------------------------------------------
VITE_MODEL=deepseek-chat
