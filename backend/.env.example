# =============================================================================
# LLM (OpenAI-compatible HTTP API) — rekommenderat / recommended: LLM_*
# =============================================================================
# Base URL / bas-URL: root for the REST API that exposes /chat/completions
# (httpx client uses this host + path). For OpenAI this is …/v1.
# OpenAI-kompatibla andra leverantörer: sätt LLM_BASE_URL till deras rot-URL.
# Other OpenAI-compatible providers: set LLM_BASE_URL to their API root.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Obligatoriskt / required — no default.
LLM_API_KEY=sk-replace-with-your-key

LLM_MAX_CONCURRENCY=32
LLM_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Legacy / bakåtkompatibelt — same meaning as LLM_* above (either set works).
# -----------------------------------------------------------------------------
# AGENT_BASE_URL=https://api.openai.com/v1
# AGENT_MODEL=gpt-4o-mini
# AGENT_API_KEY=sk-replace-with-your-key
# AGENT_MAX_CONCURRENCY=32
# AGENT_TIMEOUT_SECONDS=30

# Neo4j — use neo4j://host:7687 for routing-aware driver; bolt:// works for many single-node setups.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
# DB-namn: skapa en ny tom med schema/create_database.cypher (USE system → CREATE DATABASE …)
# och peka hit, så slipper du rensa gamla noder.
NEO4J_DATABASE=exjobbet_index

# Embedding model (sentence-transformers id) / inbäddningsmodell (Hugging Face-id)
EMBEDDING_MODEL=intfloat/e5-small-v2
